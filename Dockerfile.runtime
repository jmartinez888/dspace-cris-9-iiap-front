# Runtime-only image used by .github/workflows/deploy.yml.
#
# The workflow compiles dist/ directly on the runner (with persistent caches)
# and this Dockerfile only packages the result. Dockerfile.dist still builds
# everything inside Docker for local or standalone use; keep the runtime part
# of both files in sync.
#
# Its build context is filtered by Dockerfile.runtime.dockerignore, which only
# lets dist/ and config/ through.

ARG NODE_VERSION=22
# Node images come from Google's public Docker Hub mirror (same digests as
# docker.io/library/node) so builds do not depend on Docker Hub availability
# or rate limits. Override with --build-arg BASE_REGISTRY=docker.io/library.
ARG BASE_REGISTRY=mirror.gcr.io/library

FROM ${BASE_REGISTRY}/node:${NODE_VERSION}-alpine

WORKDIR /app

# Copy only the compiled artifacts — no source code, no node_modules bloat
COPY --chown=node:node dist /app/dist
COPY --chown=node:node config /app/config

# Drop to non-root user
USER node

# The deployed process exhausted its former 896 MiB heap under concurrent SSR.
# Keep V8 below the 2 GiB cgroup limit while allowing room for native memory.
ENV NODE_ENV=production \
    NODE_OPTIONS="--max-old-space-size=1280"

EXPOSE 4000

# Keep the probe independent from Angular SSR and allow short request queues
# during deploys or cache warm-up without triggering a restart cycle.
# During the start period the probe runs every 2 s (Docker Engine 25+), so the
# container becomes healthy, and routable by Traefik, seconds after it starts
# instead of after the first 30 s interval. BusyBox wget avoids starting a
# second Node.js process for every probe.
HEALTHCHECK --interval=30s --timeout=30s --start-period=90s --start-interval=2s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:4000/app/client/health || exit 1

CMD ["node", "dist/server/main.js"]
