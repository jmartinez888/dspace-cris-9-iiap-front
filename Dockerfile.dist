# This image will be published as dspace/dspace-angular:$DSPACE_VERSION-dist
# See https://github.com/4science/dspace-angular/tree/main/docker for usage details

# Test build:
# docker build -f Dockerfile.dist -t 4science/dspace-angular:dspace-cris-2025_02_x-dist .
#
# The deploy workflow does not use this file: it builds dist/ on the runner
# and packages it with Dockerfile.runtime. Keep both runtime stages in sync.

# Angular 20 + Node 22 optimized Dockerfile
ARG NODE_VERSION=22
# Node images come from Google's public Docker Hub mirror (same digests as
# docker.io/library/node) so builds do not depend on Docker Hub availability
# or rate limits. Override with --build-arg BASE_REGISTRY=docker.io/library.
ARG BASE_REGISTRY=mirror.gcr.io/library

# ==============================================================================
# Stage 1: BUILD — compile Angular SSR + Mirador on constrained memory
# ==============================================================================
FROM ${BASE_REGISTRY}/node:${NODE_VERSION}-alpine AS build

WORKDIR /app

# Cap V8 heap to 8 GB — gives the Angular AOT compiler ample room on a 16 GB host.
# Adjust down to 4096 on smaller instances.
# The Cypress binary is only needed for e2e tests, never for this build.
ENV NODE_OPTIONS="--max-old-space-size=8192" \
    CYPRESS_INSTALL_BINARY=0

# Install dependencies from this repository's package-lock.json, the same tree
# used for local development and tests. Copying only the manifests first keeps
# this layer cached until the lockfile changes.
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
  npm ci --no-audit --no-fund

COPY . /app/

# Build Angular browser + server bundles (production)
RUN npm run build:prod

# Build Mirador viewer plugin
RUN npm run build:mirador

# ==============================================================================
# Stage 2: PRODUCTION — ultra-lean runtime image
# ==============================================================================
FROM ${BASE_REGISTRY}/node:${NODE_VERSION}-alpine AS prod

WORKDIR /app

# Copy only the compiled artifacts — no source code, no node_modules bloat
COPY --chown=node:node --from=build /app/dist /app/dist
COPY --chown=node:node --from=build /app/config /app/config

# Drop to non-root user
USER node

# The deployed process exhausted its former 896 MiB heap under concurrent SSR.
# Keep V8 below the 2 GiB cgroup limit while allowing room for native memory.
ENV NODE_ENV=production \
    NODE_OPTIONS="--max-old-space-size=1280"

EXPOSE 4000

# Keep the probe independent from Angular SSR and allow short request queues
# during deploys or cache warm-up without triggering a restart cycle.
HEALTHCHECK --interval=30s --timeout=30s --start-period=90s --retries=3 \
  CMD node -e "require('http').get('http://localhost:4000/app/client/health', (r) => { process.exit(r.statusCode === 200 ? 0 : 1) }).on('error', () => process.exit(1))"

CMD ["node", "dist/server/main.js"]
