# syntax=docker/dockerfile:1.7-labs

# Optimized production Dockerfile for DSpace-CRIS Angular frontend
# Build: docker build -f Dockerfile.dist -t dspace-cris-frontend .

ARG NODE_VERSION=22
ARG DSPACE_VERSION=dspace-cris-2025_02_x
ARG DOCKER_REGISTRY=docker.io

# ==============================================================================
# Stage 1: BUILD — compile Angular SSR + Mirador
# ==============================================================================
FROM ${DOCKER_REGISTRY:-docker.io}/4science/dspace-cris-angular-dependencies:${DSPACE_VERSION:-dspace-cris-2025_02_x} AS build

ENV NODE_OPTIONS="--max-old-space-size=8192"

WORKDIR /app

# Cache npm dependencies layer — only re-runs if package files change
COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm \
  npm ci --legacy-peer-deps

# Copy source code after dependencies are installed
COPY . /app/

# Build Angular browser + server bundles and Mirador with persistent Angular build cache
RUN --mount=type=cache,target=/root/.npm \
    --mount=type=cache,target=/app/.angular/cache \
  npm run build:prod && npm run build:mirador

# ==============================================================================
# Stage 2: RUNTIME — ultra-lean final image (no PM2 daemon bloat)
# ==============================================================================
FROM docker.io/node:${NODE_VERSION-22}-alpine AS prod

WORKDIR /app

# Copy only compiled artifacts and runtime config — no source, no dev tools
COPY --chown=node:node --from=build /app/dist /app/dist
COPY --chown=node:node --from=build /app/config /app/config

# Drop to non-root user
USER node

ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=896"

EXPOSE 4000

# Health check (lightweight endpoint, 0% CPU, 0ms)
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "require('http').get('http://localhost:4000/app/client/health', (r) => { process.exit(r.statusCode === 200 ? 0 : 1) }).on('error', () => process.exit(1))"

# Direct node execution — no PM2 daemon overhead, no 33 PIDs, instant signals
CMD ["node", "dist/server/main.js"]
